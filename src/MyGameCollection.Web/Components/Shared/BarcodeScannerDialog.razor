@implements IAsyncDisposable
@inject IJSRuntime JS

@* Scans EAN/UPC barcodes with the device camera (live, requires HTTPS) or from a photo (works everywhere). *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" />
            <MudText Typo="Typo.h6">Scan barcode</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_liveSupported)
        {
            <div class="scanner-viewport">
                <div id="@_elementId" class="scanner-video"></div>
                @if (_starting)
                {
                    <div class="scanner-overlay"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
                }
            </div>
            @if (_cameras.Count > 1)
            {
                <MudSelect T="string" Label="Camera" Value="_cameraId" ValueChanged="SwitchCameraAsync" Dense="true" Class="mt-2" Variant="Variant.Outlined">
                    @foreach (var cam in _cameras)
                    {
                        <MudSelectItem Value="cam.Id">@cam.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Hold the barcode inside the frame. It's detected automatically.</MudText>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Live camera scanning needs HTTPS. Take a photo of the barcode instead, or type it in.
            </MudAlert>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_error</MudAlert>
        }

        <div class="d-flex flex-wrap gap-2 mt-3 align-center">
            <MudFileUpload T="IBrowserFile" Accept="image/*" FilesChanged="ScanPhotoAsync">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="@context.OpenFilePickerAsync" Disabled="_scanningPhoto">
                        @(_scanningPhoto ? "Reading…" : "From photo")
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
        </div>

        <MudTextField @bind-Value="_manual" Label="Or type the barcode" Variant="Variant.Outlined" Class="mt-3"
                      InputMode="InputMode.numeric" Immediate="true" OnKeyUp="OnManualKeyUp"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="SubmitManual" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitManual" Disabled="string.IsNullOrWhiteSpace(_manual)">Use barcode</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private readonly string _elementId = $"scanner-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<BarcodeScannerDialog>? _selfRef;
    private bool _liveSupported = true;
    private bool _starting = true;
    private bool _scanningPhoto;
    private bool _done;
    private string? _error;
    private string? _manual;
    private string? _cameraId;
    private List<CameraInfo> _cameras = [];

    public sealed record CameraInfo(string Id, string Label);
    private sealed record StartResult(bool Ok, string? Error, string? CameraId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scanner.js");
        _liveSupported = await _module.InvokeAsync<bool>("isLiveSupported");
        if (!_liveSupported)
        {
            _starting = false;
            StateHasChanged();
            return;
        }

        StateHasChanged(); // make sure the video container is rendered
        _selfRef = DotNetObjectReference.Create(this);
        await StartAsync(null);
    }

    private async Task StartAsync(string? cameraId)
    {
        _starting = true;
        _error = null;
        StateHasChanged();

        var result = await _module!.InvokeAsync<StartResult>("start", _elementId, _selfRef, cameraId);
        _starting = false;
        if (!result.Ok)
        {
            _error = result.Error ?? "Could not start the camera.";
        }
        else
        {
            _cameraId = result.CameraId;
            _cameras = await _module!.InvokeAsync<List<CameraInfo>>("listCameras");
        }
        StateHasChanged();
    }

    private async Task SwitchCameraAsync(string cameraId)
    {
        await _module!.InvokeVoidAsync("stop");
        await StartAsync(cameraId);
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string code)
    {
        if (_done) return;
        _done = true;
        await InvokeAsync(() => Dialog.Close(DialogResult.Ok(code)));
    }

    private async Task ScanPhotoAsync(IBrowserFile? file)
    {
        if (file is null || _module is null) return;
        _scanningPhoto = true;
        _error = null;
        try
        {
            // Downscale in the browser first; barcodes don't need 12MP and this keeps the transfer small.
            var resized = await file.RequestImageFileAsync("image/jpeg", 1600, 1600);
            await using var stream = resized.OpenReadStream(PhotoRules.MaxPhotoBytes);
            using var streamRef = new DotNetStreamReference(stream);
            var code = await _module.InvokeAsync<string?>("scanImage", streamRef);
            if (string.IsNullOrWhiteSpace(code))
                _error = "No barcode found in that photo. Try again closer and in focus.";
            else
                await OnBarcodeScanned(code);
        }
        catch (Exception ex)
        {
            _error = $"Could not read the photo: {ex.Message}";
        }
        finally
        {
            _scanningPhoto = false;
        }
    }

    private void OnManualKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitManual();
    }

    private void SubmitManual()
    {
        if (string.IsNullOrWhiteSpace(_manual)) return;
        _done = true;
        Dialog.Close(DialogResult.Ok(_manual.Trim()));
    }

    private void Cancel() => Dialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
