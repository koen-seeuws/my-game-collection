<a href="@Href" class="stat-card-link">
    <MudPaper Outlined="true" Class="pa-4 stat-card">
        <div class="d-flex align-center gap-3">
            <MudAvatar Color="Color" Variant="Variant.Filled" Rounded="true">
                <MudIcon Icon="@Icon" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h5" Class="stat-value">@Value</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
            </div>
        </div>
    </MudPaper>
</a>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public string? Href { get; set; }
}
