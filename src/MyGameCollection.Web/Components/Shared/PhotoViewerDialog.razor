<MudDialog ContentClass="pa-0">
    <DialogContent>
        <div class="photo-viewer">
            <img src="@($"/photos/{PhotoIds[_index]}/full")" alt="Photo @(_index + 1)" />
            @if (PhotoIds.Count > 1)
            {
                <MudIconButton Class="viewer-nav viewer-prev" Icon="@Icons.Material.Filled.ChevronLeft" OnClick="() => Move(-1)" aria-label="Previous" />
                <MudIconButton Class="viewer-nav viewer-next" Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => Move(1)" aria-label="Next" />
                <MudText Typo="Typo.caption" Class="viewer-counter">@(_index + 1) / @PhotoIds.Count</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Href="@($"/photos/{PhotoIds[_index]}/full")" Target="_blank" StartIcon="@Icons.Material.Filled.OpenInNew">Open original</MudButton>
        <MudButton OnClick="() => Dialog.Close()">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<Guid> PhotoIds { get; set; } = [];
    [Parameter] public Guid StartPhotoId { get; set; }

    private int _index;

    protected override void OnInitialized() => _index = Math.Max(0, PhotoIds.ToList().IndexOf(StartPhotoId));

    private void Move(int delta) => _index = (_index + delta + PhotoIds.Count) % PhotoIds.Count;
}
