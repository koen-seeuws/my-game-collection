<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>my-game-collection-web</UserSecretsId>
    <!--
      The SDK only restores the package with _framework/blazor.web.js when it sees .razor files during restore.
      The Dockerfile restores with just the .csproj files (for layer caching), so declare it explicitly.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyGameCollection.Application\MyGameCollection.Application.csproj" />
    <ProjectReference Include="..\MyGameCollection.Infrastructure.Persistence\MyGameCollection.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\MyGameCollection.Infrastructure.Storage\MyGameCollection.Infrastructure.Storage.csproj" />
    <ProjectReference Include="..\MyGameCollection.Infrastructure.Barcodes\MyGameCollection.Infrastructure.Barcodes.csproj" />
    <ProjectReference Include="..\MyGameCollection.Infrastructure.Metadata\MyGameCollection.Infrastructure.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
