@using MyGameCollection.Application.Abstractions.Queries.GetMyGames
@* A game's details, read-only, shown when opening it before choosing to edit.
   Grouped like the game form, so everything that was filled in can be found again. *@
<div class="item-details">
    <ItemThumbnail Url="@Model.ThumbnailUrl" Icon="@Icons.Material.Outlined.VideogameAsset" Alt="@Model.Title"
                   Class="item-details-thumbnail" />
    <div class="item-details-body">
        <StatusChip Status="Model.Status" />

        <MudGrid Spacing="2" Class="mt-1">
            <FormSection Title="Game" Icon="@Icons.Material.Outlined.VideogameAsset" />
            <DetailField Label="Platform">@Model.Platform</DetailField>
            <DetailField Label="Edition">@(string.IsNullOrWhiteSpace(Model.Edition) ? "Standard" : Model.Edition)</DetailField>
            @if (Model.Type is { } type)
            {
                <DetailField Label="Type">@type.ToDisplayName()</DetailField>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Series))
            {
                <DetailField Label="Series">@Model.Series</DetailField>
            }
            @if (Model.Genres.Count > 0)
            {
                <DetailField Label="@(Model.Genres.Count == 1 ? "Genre" : "Genres")">@string.Join(" · ", Model.Genres)</DetailField>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AgeRating))
            {
                <DetailField Label="Age rating">@Model.AgeRating</DetailField>
            }
            @if (Model.Developers.Count > 0)
            {
                <DetailField Label="@(Model.Developers.Count == 1 ? "Developer" : "Developers")">@string.Join(", ", Model.Developers)</DetailField>
            }
            @if (Model.Publishers.Count > 0)
            {
                <DetailField Label="@(Model.Publishers.Count == 1 ? "Publisher" : "Publishers")">@string.Join(", ", Model.Publishers)</DetailField>
            }

            <FormSection Title="Region & release" Icon="@Icons.Material.Outlined.Public" />
            <DetailField Label="Region">@Model.Region.ToDisplayName()</DetailField>
            <DetailField Label="Released">@(Model.ReleaseDate?.ToString() ?? "Unknown")</DetailField>

            @if (Model.Players is { } players)
            {
                <FormSection Title="Players" Icon="@Icons.Material.Outlined.Groups" />
                <DetailField Label="Single-player">@(players.SinglePlayer ? "Yes" : "No")</DetailField>
                @if (players.HasLocalMultiplayer || players.HasOnlineMultiplayer)
                {
                    <DetailField Label="On one console">
                        @(players.HasLocalMultiplayer ? DisplayNames.LocalPlayersDescription(players) : "No")
                    </DetailField>
                    <DetailField Label="Online">
                        @(players.HasOnlineMultiplayer ? DisplayNames.OnlinePlayersDescription(players) : "No")
                    </DetailField>
                }
                else
                {
                    <DetailField Label="Multiplayer">
                        @(players.Multiplayer ? "Yes; not known whether on one console or online" : "No")
                    </DetailField>
                }
            }

            <FormSection Title="Your copy" Icon="@Icons.Material.Outlined.Inventory2" />
            <DetailField Label="Format">@Model.Format.ToDisplayName()</DetailField>
            @if (Model.IsPhysical)
            {
                <DetailField Label="Completeness">@Model.Completeness.ToDisplayName()</DetailField>
                @if (Owned)
                {
                    <DetailField Label="Condition">@Model.Condition.ToDisplayName()</DetailField>
                }
            }

            @if (Owned)
            {
                <FormSection Title="Purchase" Icon="@Icons.Material.Outlined.ShoppingBag" />
                <DetailField Label="@(Model.Format == GameFormat.Subscription ? "Claimed on" : "Purchased")">
                    @(Model.PurchaseDate is { } purchased ? DisplayNames.Date(DateOnly.FromDateTime(purchased)) : "Unknown")
                </DetailField>
                @if (Model.Format != GameFormat.Subscription)
                {
                    <DetailField Label="Price paid">
                        @(Model.PurchasePrice is not null ? DisplayNames.Money(Model.PurchasePrice) : "Unknown")
                    </DetailField>
                }
                @if (Model.IsPhysical)
                {
                    <DetailField Label="Bought">@(Model.PurchaseOrigin?.ToDisplayName() ?? "Unknown")</DetailField>
                }

                <FormSection Title="Playing" Icon="@Icons.Material.Outlined.SportsEsports" />
                <DetailField Label="Play status">
                    @if (Model.PlayStatus is { } playStatus)
                    {
                        <span class="@($"item-tag play-status {playStatus.ToString().ToLowerInvariant()}")">
                            <MudIcon Icon="@playStatus.ToIcon()" Class="item-tag-icon" />
                            @playStatus.ToDisplayName()
                        </span>
                    }
                    else
                    {
                        <span>Not tracked</span>
                    }
                </DetailField>
                @if (Model.PlayStatus.IsFinished() && Model.CompletedOn is { } completed)
                {
                    <DetailField Label="Completed on">@DisplayNames.Date(DateOnly.FromDateTime(completed))</DetailField>
                }
            }

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <FormSection Title="Notes" Icon="@Icons.Material.Outlined.StickyNote2" />
                <DetailField Wide="true"><span class="detail-notes">@Model.Notes</span></DetailField>
            }
        </MudGrid>
        @if (GameKey is { } gameKey)
        {
            <GameAddOns GameKey="gameKey" GameTitle="@Model.Title" GameCatalogId="Model.CatalogId" AddOns="AddOns"
                        OnChanged="OnAddOnsChanged" />
        }
        <GameCatalogDetails CatalogId="Model.CatalogId" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameFormModel Model { get; set; } = default!;

    /// <summary>The game's key, to manage its add-ons. Empty for a game that is not saved yet.</summary>
    [Parameter] public Guid? GameKey { get; set; }

    [Parameter] public IReadOnlyList<AddOnDto> AddOns { get; set; } = [];

    /// <summary>Raised after an add-on was added, changed or deleted.</summary>
    [Parameter] public EventCallback OnAddOnsChanged { get; set; }

    private bool Owned => Model.Status == CollectionStatus.Owned;
}
