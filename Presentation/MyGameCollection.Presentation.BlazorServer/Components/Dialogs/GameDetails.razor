@using MyGameCollection.Application.Abstractions.Queries.GetMyGames
@* A game's details, read-only, shown when opening it before choosing to edit. *@
<div class="item-details">
    <ItemThumbnail Url="@Model.ThumbnailUrl" Icon="@Icons.Material.Outlined.VideogameAsset" Alt="@Model.Title"
                   Class="item-details-thumbnail" />
    <div class="item-details-body">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @string.Join(" · ", new[] { Model.Platform, Model.Edition }.Where(t => !string.IsNullOrWhiteSpace(t)))
        </MudText>
        <StatusChip Status="Model.Status" />
        <ItemTags Format="Model.Format" Region="Model.Region"
                  Completeness="@(Model.IsPhysical ? Model.Completeness : null)"
                  Condition="@(Owned && Model.IsPhysical ? Model.Condition : null)"
                  Origin="@(Owned && Model.IsPhysical ? Model.PurchaseOrigin : null)" />
        <PlayerTags Players="Model.Players" />

        <MudGrid Spacing="2" Class="mt-2">
            @if (Model.Genres.Count > 0)
            {
                <DetailField Label="Genres" Wide="true">@string.Join(" · ", Model.Genres)</DetailField>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Series))
            {
                <DetailField Label="Series">@Model.Series</DetailField>
            }
            @if (Model.Type is { } type)
            {
                <DetailField Label="Type">@type.ToDisplayName()</DetailField>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AgeRating))
            {
                <DetailField Label="Age rating">@Model.AgeRating</DetailField>
            }
            @if (Model.Developers.Count > 0)
            {
                <DetailField Label="Developers">@string.Join(", ", Model.Developers)</DetailField>
            }
            @if (Model.Publishers.Count > 0)
            {
                <DetailField Label="Publishers">@string.Join(", ", Model.Publishers)</DetailField>
            }
            @if (Model.ReleaseDate is { } released)
            {
                <DetailField Label="Released">@released</DetailField>
            }
            @if (Owned && Model.PurchaseDate is { } purchased)
            {
                <DetailField Label="@(Model.Format == GameFormat.Subscription ? "Claimed on" : "Purchased")">
                    @DisplayNames.Date(DateOnly.FromDateTime(purchased))
                </DetailField>
            }
            @if (Owned && Model.Format != GameFormat.Subscription && Model.PurchasePrice is not null)
            {
                <DetailField Label="Price paid">@DisplayNames.Money(Model.PurchasePrice)</DetailField>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <DetailField Label="Notes" Wide="true"><span class="detail-notes">@Model.Notes</span></DetailField>
            }
        </MudGrid>
        @if (GameKey is { } gameKey)
        {
            <GameAddOns GameKey="gameKey" GameTitle="@Model.Title" GameCatalogId="Model.CatalogId" AddOns="AddOns"
                        OnChanged="OnAddOnsChanged" />
        }
        <GameCatalogDetails CatalogId="Model.CatalogId" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameFormModel Model { get; set; } = default!;

    /// <summary>The game's key, to manage its add-ons. Empty for a game that is not saved yet.</summary>
    [Parameter] public Guid? GameKey { get; set; }

    [Parameter] public IReadOnlyList<AddOnDto> AddOns { get; set; } = [];

    /// <summary>Raised after an add-on was added, changed or deleted.</summary>
    [Parameter] public EventCallback OnAddOnsChanged { get; set; }

    private bool Owned => Model.Status == CollectionStatus.Owned;
}
