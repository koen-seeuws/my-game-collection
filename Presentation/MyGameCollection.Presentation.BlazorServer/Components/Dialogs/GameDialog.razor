@using System.Globalization
@using MyGameCollection.Application.Abstractions.Services.GameCatalog
@using MyGameCollection.Application.Abstractions.Services
@inject IGameCatalogService GameCatalog
@implements IDisposable

<MudDialog>
    <DialogContent>
        <CatalogLookup TItem="CatalogGameDto" Label="Find the game on IGDB" SearchFunc="SearchCatalogAsync"
                       ItemName="g => g.Name" InitialSearch="@Model.Title" AutoFocus="string.IsNullOrEmpty(Model.Title)" OnSelected="ApplyCatalogGame">
            <ItemTemplate Context="game">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (game.CoverUrl is not null)
                    {
                        <img src="@game.CoverUrl" alt="" class="catalog-cover" loading="lazy" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.VideogameAsset" Class="catalog-cover" />
                    }
                    <div>
                        <MudText Typo="Typo.body1">
                            @game.Name @(game.ReleaseDate is { } released ? $"({released})" : "")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @string.Join(", ", game.Platforms.Select(p => p.Abbreviation ?? p.Name))
                        </MudText>
                    </div>
                </MudStack>
            </ItemTemplate>
        </CatalogLookup>
        @if (_editionsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_catalogGame is { } catalogGame && _catalogEditions.Count > 0)
        {
            <div class="mb-4">
                <MudText Typo="Typo.subtitle2">Which edition is it?</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    IGDB knows @(_catalogEditions.Count + 1) editions of @catalogGame.Name. Pick yours to use its cover.
                </MudText>
                <div class="version-picker covers mt-2">
                    <button type="button" class="@($"version-option{(_catalogEdition is null ? " selected" : "")}")"
                            aria-pressed="@(_catalogEdition is null ? "true" : "false")" @onclick="ApplyStandardEdition">
                        <EditionCover Url="@catalogGame.CoverUrl" />
                        <span class="version-option-name">Standard edition</span>
                        @if (catalogGame.ReleaseDate is { } standardReleased)
                        {
                            <span class="version-option-year">@standardReleased.Year</span>
                        }
                    </button>
                    @foreach (var edition in _catalogEditions)
                    {
                        var selected = edition.Id == _catalogEdition?.Id;
                        <button type="button" class="@($"version-option{(selected ? " selected" : "")}")"
                                aria-pressed="@(selected ? "true" : "false")" @onclick="() => ApplyCatalogEdition(edition)">
                            <EditionCover Url="@edition.CoverUrl" />
                            <span class="version-option-name">@edition.Edition</span>
                            @if (edition.ReleaseDate is { } released)
                            {
                                <span class="version-option-year">@released.Year</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
        <EditForm id="@_formId" Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="Model.Title" For="() => Model.Title" Label="Title"
                                  Variant="Variant.Outlined" MaxLength="200" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudAutocomplete T="string" @bind-Value="Model.Platform" For="() => Model.Platform" Label="Platform"
                                     Variant="Variant.Outlined" SearchFunc="SearchPlatformsAsync" MaxItems="null"
                                     CoerceText="false" CoerceValue="true" ResetValueOnEmptyText="true"
                                     HelperText="Use the same name as the console" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Edition" For="() => Model.Edition" Label="Edition"
                                  Variant="Variant.Outlined" MaxLength="100" Clearable="true"
                                  Placeholder="e.g. Game of the Year Edition" HelperText="Leave empty for the standard edition" />
                </MudItem>
                @if (_catalogPlatforms.Count > 1)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Released on:</MudText>
                        <MudChipSet T="string" SelectedValue="Model.Platform" SelectedValueChanged="p => Model.Platform = p ?? Model.Platform"
                                    SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary">
                            @foreach (var platform in _catalogPlatforms)
                            {
                                <MudChip T="string" Value="platform" Text="@platform" />
                            }
                        </MudChipSet>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Format</MudText>
                    <MudToggleGroup T="GameFormat" @bind-Value="Model.Format" SelectionMode="SelectionMode.SingleSelection"
                                    Color="Color.Primary" CheckMark="true" FixedContent="true" Size="Size.Small">
                        @foreach (var format in Enum.GetValues<GameFormat>())
                        {
                            <MudToggleItem T="GameFormat" Value="format" Text="@format.ToDisplayName()" />
                        }
                    </MudToggleGroup>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.Format.ToDescription()</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <EnumSelect TEnum="CollectionStatus" @bind-Value="Model.Status" Label="Status" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <EnumSelect TEnum="Region" @bind-Value="Model.Region" Label="Region" />
                </MudItem>
                @if (Model.IsPhysical)
                {
                    <MudItem xs="12" sm="6">
                        <EnumSelect TEnum="Completeness" @bind-Value="Model.Completeness" Label="Completeness" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <EnumSelect TEnum="ItemCondition" @bind-Value="Model.Condition" Label="Condition" />
                    </MudItem>
                }
                <ReleaseDateFields Model="Model" />
                @if (Model.Status == CollectionStatus.Owned)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="Model.PurchaseDate"
                                       Label="@(Model.Format == GameFormat.Subscription ? "Claimed on" : "Purchase date")"
                                       Variant="Variant.Outlined" Clearable="true" MaxDate="DateTime.Today" />
                    </MudItem>
                    @if (Model.Format != GameFormat.Subscription)
                    {
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="Model.PurchasePrice" For="() => Model.PurchasePrice"
                                             Label="Price paid" Variant="Variant.Outlined" HideSpinButtons="true" Min="0"
                                             Adornment="Adornment.Start" AdornmentText="@CurrencySymbol" />
                        </MudItem>
                    }
                    @if (Model.IsPhysical)
                    {
                        <MudItem xs="12">
                            <PurchaseOriginField @bind-Value="Model.PurchaseOrigin" />
                        </MudItem>
                    }
                }
                <MudItem xs="12">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <ItemThumbnail Url="@Model.ThumbnailUrl" Icon="@Icons.Material.Outlined.VideogameAsset" Class="thumbnail-preview" />
                        <MudTextField @bind-Value="Model.ThumbnailUrl" For="() => Model.ThumbnailUrl" Label="Thumbnail URL"
                                      Variant="Variant.Outlined" MaxLength="500" Immediate="true" Clearable="true"
                                      Placeholder="https://..." HelperText="Filled in from IGDB when available"
                                      Class="flex-grow-1" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Notes" For="() => Model.Notes" Label="Notes" Variant="Variant.Outlined"
                                  Lines="3" MaxLength="2000" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="@_formId" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public GameFormModel Model { get; set; } = new();

    /// <summary>Platforms already used in the collection, suggested before the well-known ones.</summary>
    [Parameter]
    public IEnumerable<string> Platforms { get; set; } = [];


    private readonly string _formId = $"game-form-{Guid.NewGuid():N}";

    /// <summary>The platforms the picked catalog game was released on, in this collection's naming.</summary>
    private IReadOnlyList<string> _catalogPlatforms = [];

    private static string CurrencySymbol => CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;

    private Task<IReadOnlyList<CatalogGameDto>> SearchCatalogAsync(string search, CancellationToken ct) =>
        GameCatalog.SearchGamesAsync(search, ct);

    /// <summary>The game last picked from IGDB, whose editions are offered in the edition picker.</summary>
    private CatalogGameDto? _catalogGame;

    private IReadOnlyList<CatalogGameEditionDto> _catalogEditions = [];
    private CatalogGameEditionDto? _catalogEdition;
    private bool _editionsLoading;
    private CancellationTokenSource? _editionsCts;

    private async Task ApplyCatalogGame(CatalogGameDto game)
    {
        ApplyCatalogGameDetails(game);
        await LoadEditionsAsync(game);
    }

    private void ApplyCatalogGameDetails(CatalogGameDto game)
    {
        _catalogGame = game;
        _catalogEditions = [];
        _catalogEdition = null;

        Model.Title = game.Name;
        Model.Edition = null;
        Model.ReleaseDate = game.ReleaseDate ?? Model.ReleaseDate;
        Model.ThumbnailUrl = game.ThumbnailUrl ?? Model.ThumbnailUrl;

        _catalogPlatforms = game.Platforms
            .Select(p => KnownPlatforms.Match(Platforms, p.Name, p.Abbreviation))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        Model.Platform = ChoosePlatform() ?? Model.Platform;
    }

    private async Task LoadEditionsAsync(CatalogGameDto game)
    {
        _editionsCts?.Cancel();
        _editionsCts?.Dispose();
        var cts = _editionsCts = new CancellationTokenSource();

        _editionsLoading = true;
        try
        {
            var editions = await GameCatalog.GetGameEditionsAsync(game.Id, cts.Token);
            if (!cts.IsCancellationRequested)
                _catalogEditions = editions;
        }
        catch (OperationCanceledException)
        {
            // Another game was picked meanwhile.
        }
        catch (CatalogUnavailableException)
        {
            // Editions are a nice-to-have: the game itself is already filled in.
        }
        finally
        {
            if (ReferenceEquals(_editionsCts, cts))
                _editionsLoading = false;
        }
    }

    private void ApplyCatalogEdition(CatalogGameEditionDto edition)
    {
        _catalogEdition = edition;
        Model.Edition = edition.Edition;
        Model.ThumbnailUrl = edition.ThumbnailUrl ?? _catalogGame?.ThumbnailUrl ?? Model.ThumbnailUrl;
    }

    private void ApplyStandardEdition()
    {
        _catalogEdition = null;
        Model.Edition = null;
        Model.ThumbnailUrl = _catalogGame?.ThumbnailUrl ?? Model.ThumbnailUrl;
    }

    public void Dispose()
    {
        _editionsCts?.Cancel();
        _editionsCts?.Dispose();
    }

    /// <summary>
    /// The most likely platform of the picked game: the only one it was released on, the one already chosen, or the only one of its platforms in the collection. Otherwise the user picks.
    /// </summary>
    private string? ChoosePlatform()
    {
        bool Released(string? platform) =>
            platform is not null && _catalogPlatforms.Contains(platform, StringComparer.OrdinalIgnoreCase);

        if (_catalogPlatforms.Count == 1)
            return _catalogPlatforms[0];
        if (Released(Model.Platform))
            return _catalogPlatforms.First(p => p.Equals(Model.Platform, StringComparison.OrdinalIgnoreCase));

        var inCollection = _catalogPlatforms.Where(p => Platforms.Contains(p, StringComparer.OrdinalIgnoreCase)).ToList();
        return inCollection.Count == 1 ? inCollection[0] : null;
    }

    private Task<IEnumerable<string>> SearchPlatformsAsync(string? search, CancellationToken _) =>
        Task.FromResult(KnownPlatforms.Suggest(Platforms, KnownPlatforms.All.Select(p => p.Name), search));

    private void Submit() => MudDialog.Close(DialogResult.Ok(Model));
}
