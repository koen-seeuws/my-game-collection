@implements IAsyncDisposable
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        @if (_error is null)
        {
            <div class="barcode-scanner">
                <video @ref="_video" playsinline muted></video>
            </div>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                Point the camera at the barcode on the back of the box.
            </MudText>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BarcodeScannerDialog>? _self;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/barcodeScanner.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("start", _video, _self);
        }
        catch (JSException ex)
        {
            _error = ex.Message.Split('\n')[0];
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnBarcodeDetected(string code) => InvokeAsync(() => MudDialog.Close(DialogResult.Ok(code)));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser tab is gone, and the camera with it.
            }
        }

        _self?.Dispose();
    }
}
