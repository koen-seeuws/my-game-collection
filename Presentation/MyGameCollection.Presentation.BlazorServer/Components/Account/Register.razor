@page "/account/register/{Token}"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MyGameCollection.Application.Abstractions.Commands.RedeemInvite
@using MyGameCollection.Application.Abstractions.Queries.GetOpenInvite
@inject IUseCaseDispatcher Dispatcher
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Create your account · My Game Collection</PageTitle>

@if (_invite is null)
{
    <h1>Invite not valid</h1>
    <p class="account-hint">
        This invite link is invalid, has expired or has already been used. Ask for a new one.
    </p>
    <a class="account-button" href="account/login">Go to sign in</a>
}
else
{
    <h1>Create your account</h1>
    @if (_invite.GrantsAdmin)
    {
        <p class="account-hint">This is the first account: it will be the administrator, who can invite others.</p>
    }

    @if (_errors.Count > 0)
    {
        <div class="account-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register" class="account-form">
        <DataAnnotationsValidator />

        <label for="firstname">First name</label>
        <InputText id="firstname" @bind-Value="Input.FirstName" autocomplete="given-name" autofocus />
        <ValidationMessage For="() => Input.FirstName" />

        <label for="lastname">Last name</label>
        <InputText id="lastname" @bind-Value="Input.LastName" autocomplete="family-name" />
        <ValidationMessage For="() => Input.LastName" />

        <label for="email">Email <span class="account-label-hint">(you sign in with it)</span></label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" />
        <ValidationMessage For="() => Input.Email" />

        <label for="password">Password <span class="account-label-hint">(at least 10 characters)</span></label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
        <ValidationMessage For="() => Input.Password" />

        <label for="confirm">Confirm password</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" />

        <button type="submit" class="account-button">Create account</button>
    </EditForm>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    private RegisterModel Input { get; set; } = default!;

    private OpenInviteDto? _invite;
    private IReadOnlyList<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _invite = await Dispatcher.QueryAsync(new GetOpenInviteQuery { Token = Token });
    }

    private async Task RegisterAsync()
    {
        if (_invite is null)
            return;

        RedeemInviteResultDto result;
        try
        {
            result = await Dispatcher.SendAsync(new RedeemInviteCommand
            {
                Token = Token,
                FirstName = Input.FirstName,
                LastName = Input.LastName,
                Email = Input.Email,
                Password = Input.Password
            });
        }
        catch (InvalidOperationException ex)
        {
            // E.g. somebody else used the same link at the same moment.
            _errors = [ex.Message];
            return;
        }

        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        var user = await UserManager.FindByIdAsync(result.UserId!);
        await SignInManager.SignInAsync(user!, isPersistent: false);
        Navigation.NavigateTo("/");
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Enter your first name.")]
        [StringLength(RedeemInviteCommand.MaxNameLength, ErrorMessage = "Keep it under 100 characters.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your last name.")]
        [StringLength(RedeemInviteCommand.MaxNameLength, ErrorMessage = "Keep it under 100 characters.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Choose a password.")]
        [StringLength(128, MinimumLength = 10, ErrorMessage = "Use at least 10 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
