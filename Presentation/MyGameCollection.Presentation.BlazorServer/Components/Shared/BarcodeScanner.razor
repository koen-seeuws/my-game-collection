@inject IJSRuntime JS
@implements IAsyncDisposable

@* Shows the camera and reports the first EAN / UPC barcode it reads. *@
<div class="barcode-scanner mt-3">
    <div class="barcode-scanner-view" hidden="@(_error is not null)">
        <video @ref="_video" playsinline muted></video>
        @if (_error is null)
        {
            <div class="barcode-scanner-guide" aria-hidden="true"></div>
        }
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_error</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
            @(_starting ? "Starting the camera..." : "Hold the barcode on the box inside the frame.")
        </MudText>
    }

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1">
        @if (_error is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="StartAsync">Try again</MudButton>
        }
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CloseAsync">Close camera</MudButton>
    </MudStack>
</div>

@code {
    /// <summary>Raised with the barcode's digits once one is read; the camera is already off by then.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnScanned { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BarcodeScanner>? _self;
    private bool _starting = true;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await StartAsync();
    }

    private async Task StartAsync()
    {
        _starting = true;
        _error = null;
        StateHasChanged();

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["Components/Shared/BarcodeScanner.razor.js"]);
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("start", _video, _self);
        }
        catch (JSException ex)
        {
            _error = Describe(ex.Message);
        }
        catch (JSDisconnectedException)
        {
            // The page is closing.
        }
        finally
        {
            _starting = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnDetected(string code) => await OnScanned.InvokeAsync(code.Trim());

    private async Task CloseAsync()
    {
        await StopAsync();
        await OnClose.InvokeAsync();
    }

    private async Task StopAsync()
    {
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("stop", _video);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
            // The camera goes off with the page anyway.
        }
    }

    /// <summary>Says in plain words why the camera did not start.</summary>
    private static string Describe(string error) => error switch
    {
        _ when error.Contains("NotAllowed", StringComparison.OrdinalIgnoreCase) || error.Contains("Permission", StringComparison.OrdinalIgnoreCase)
            => "The camera is blocked. Allow camera access for this site in your browser, then try again.",
        _ when error.Contains("NotFound", StringComparison.OrdinalIgnoreCase) || error.Contains("Requested device not found", StringComparison.OrdinalIgnoreCase)
            => "No camera was found on this device.",
        _ when error.Contains("NotReadable", StringComparison.OrdinalIgnoreCase)
            => "The camera is in use by another app. Close it and try again.",
        _ => error.Split('\n')[0]
    };

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
