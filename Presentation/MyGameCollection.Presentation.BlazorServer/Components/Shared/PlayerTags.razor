@* Who can play a game: alone, on the couch or online, as compact tags with the details in a tooltip. *@
@if (Players is { } players)
{
    <div class="item-tags">
        @if (players.HasLocalMultiplayer)
        {
            <span class="item-tag players local" title="@DisplayNames.LocalPlayersDescription(players)">
                <MudIcon Icon="@Icons.Material.Outlined.Weekend" Class="item-tag-icon" />@DisplayNames.LocalPlayersLabel(players)
            </span>
        }
        @if (players.HasOnlineMultiplayer)
        {
            <span class="item-tag players online" title="@DisplayNames.OnlinePlayersDescription(players)">
                <MudIcon Icon="@Icons.Material.Outlined.Public" Class="item-tag-icon" />@DisplayNames.OnlinePlayersLabel(players)
            </span>
        }
        @if (players.Multiplayer && !players.HasLocalMultiplayer && !players.HasOnlineMultiplayer)
        {
            <span class="item-tag players" title="Multiplayer; IGDB does not say whether on one console or online">
                <MudIcon Icon="@Icons.Material.Outlined.Groups" Class="item-tag-icon" />Multiplayer
            </span>
        }
        @if (players.SinglePlayer && !players.Multiplayer)
        {
            <span class="item-tag players" title="Single-player only">
                <MudIcon Icon="@Icons.Material.Outlined.Person" Class="item-tag-icon" />Single-player
            </span>
        }
    </div>
}

@code {
    /// <summary>Empty when it is not known how the game is played; then nothing is shown.</summary>
    [Parameter] public PlayerModes? Players { get; set; }
}
