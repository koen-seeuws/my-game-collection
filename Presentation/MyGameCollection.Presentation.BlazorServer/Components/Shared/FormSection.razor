@* The heading of a group of fields in a form, as a full-width grid item with a divider above it (except for the first group). *@
<MudItem xs="12" Class="form-section">
    <MudDivider Class="form-section-divider" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @if (Icon is not null)
        {
            <MudIcon Icon="@Icon" Size="Size.Small" Color="Color.Primary" />
        }
        <MudText Typo="Typo.overline" Class="form-section-title">@Title</MudText>
    </MudStack>
</MudItem>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Icon { get; set; }
}
