@* A grid of game cards, with the open, delete and acquire actions handed to the page.
   Cards only show what tells games apart at a glance; the rest is in the game's details. *@
<div class="item-grid">
    @foreach (var game in Games)
    {
        <ItemCard @key="game.Key" Title="@game.Title" Subtitle="@Subtitle(game)" ThumbnailUrl="@game.ThumbnailUrl"
                  Icon="@Icons.Material.Outlined.VideogameAsset" Status="game.Status" Notes="@game.Notes"
                  PurchasePrice="game.PurchasePrice" PurchaseDate="game.PurchaseDate"
                  OnOpen="() => OnOpen.InvokeAsync(game)" OnDelete="() => OnDelete.InvokeAsync(game)"
                  OnAcquire="() => OnAcquire.InvokeAsync(game)">
            <GameCardTags Game="game" />
        </ItemCard>
    }
</div>
