@* Format, region, completeness, condition and purchase origin of an item, as compact tags. *@
<div class="item-tags">
    @if (Format is { } format)
    {
        <span class="@($"item-tag format {format.ToString().ToLowerInvariant()}")">@format.ToDisplayName()</span>
    }
    <span class="item-tag region">@Region.ToDisplayName()</span>
    @if (Completeness is { } completeness)
    {
        <span class="item-tag">@completeness.ToDisplayName()</span>
    }
    @if (Condition is { } condition)
    {
        <span class="item-tag">@condition.ToDisplayName()</span>
    }
    @if (Origin is { } origin)
    {
        <span class="@($"item-tag origin {origin.ToString().ToLowerInvariant()}")">@origin.ToDisplayName()</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public Region Region { get; set; }

    /// <summary>Left out for digital games, which have no box.</summary>
    [Parameter] public Completeness? Completeness { get; set; }

    /// <summary>Left out for wishlist items and digital games, which have no condition.</summary>
    [Parameter] public ItemCondition? Condition { get; set; }

    /// <summary>Only games have a format; consoles leave it out.</summary>
    [Parameter] public GameFormat? Format { get; set; }

    /// <summary>New or secondhand; left out when unknown.</summary>
    [Parameter] public PurchaseOrigin? Origin { get; set; }
}
