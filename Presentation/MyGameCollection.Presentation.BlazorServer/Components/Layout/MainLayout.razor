@inherits LayoutComponentBase
@implements IDisposable
@inject CurrentUser CurrentUser

@* The neon sci-fi look only exists as a dark theme. *@
<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="neon-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle navigation" />
        <MudIcon Icon="@Icons.Material.Filled.VideogameAsset" Class="ml-2 neon-logo" />
        <MudText Typo="Typo.h6" Class="ml-3 neon-title">My Game Collection</MudText>
        <MudSpacer />
        @if (CurrentUser.IsSignedIn)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-2 neon-user d-none d-sm-flex">
                @CurrentUser.DisplayName
            </MudChip>
            <form action="account/logout" method="post" class="d-inline-flex">
                <AntiforgeryToken />
                <MudTooltip Text="Sign out">
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                                   aria-label="Sign out" />
                </MudTooltip>
            </form>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="neon-drawer">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="games" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SportsEsports">Games</MudNavLink>
            <MudNavLink Href="consoles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VideogameAsset">Consoles</MudNavLink>
            <MudNavLink Href="accessories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gamepad">Accessories</MudNavLink>
            <MudNavLink Href="wishlist" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Favorite">Wishlist</MudNavLink>
            @if (CurrentUser.IsAdmin)
            {
                <MudNavLink Href="admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private static readonly string[] HeadingFont = ["Orbitron", "Exo 2", "sans-serif"];

    // Dark-blue sci-fi: a deep navy base with neon cyan and magenta accents.
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#22D3EE",
            PrimaryContrastText = "#041024",
            Secondary = "#F472D0",
            SecondaryContrastText = "#160320",
            Tertiary = "#A78BFA",
            Info = "#38BDF8",
            InfoContrastText = "#041024",
            Success = "#2EF2A2",
            SuccessContrastText = "#03170F",
            Warning = "#FFC94D",
            WarningContrastText = "#1C1200",
            Error = "#FF4D6D",
            Background = "#050B1A",
            BackgroundGray = "#08132A",
            Surface = "#0B1733",
            DrawerBackground = "#06102A",
            DrawerText = "#B9D3F0",
            DrawerIcon = "#5FE3F7",
            AppbarBackground = "rgba(5, 12, 30, 0.82)",
            AppbarText = "#E2F3FF",
            TextPrimary = "#E2F3FF",
            TextSecondary = "#8EA7C8",
            TextDisabled = "rgba(142, 167, 200, 0.45)",
            ActionDefault = "#8EA7C8",
            LinesDefault = "rgba(56, 189, 248, 0.18)",
            LinesInputs = "rgba(56, 189, 248, 0.35)",
            TableLines = "rgba(56, 189, 248, 0.12)",
            TableHover = "rgba(34, 211, 238, 0.06)",
            Divider = "rgba(56, 189, 248, 0.18)",
            OverlayDark = "rgba(2, 6, 18, 0.75)",
            Skeleton = "rgba(56, 189, 248, 0.08)"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Exo 2", "Roboto", "sans-serif"] },
            H4 = new H4Typography { FontFamily = HeadingFont, FontWeight = "700", LetterSpacing = "0.06em", TextTransform = "uppercase" },
            H5 = new H5Typography { FontFamily = HeadingFont, FontWeight = "600", LetterSpacing = "0.03em" },
            H6 = new H6Typography { FontFamily = HeadingFont, FontWeight = "600", LetterSpacing = "0.04em" },
            Button = new ButtonTypography { FontFamily = ["Exo 2", "Roboto", "sans-serif"], FontWeight = "600", LetterSpacing = "0.08em", TextTransform = "uppercase" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" }
    };

    protected override void OnInitialized() => CurrentUser.Changed += OnUserChanged;

    private void OnUserChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => CurrentUser.Changed -= OnUserChanged;
}
