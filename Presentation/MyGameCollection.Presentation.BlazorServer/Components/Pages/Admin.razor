@page "/admin"
@attribute [Authorize(Roles = InviteService.AdminRole)]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Admin · My Game Collection</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Admin</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Elevation="1" Class="pa-4" Style="height: 100%">
            <MudText Typo="Typo.h6" GutterBottom="true">Invite someone</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Nobody can sign up on their own. Create a link and send it to the person you want to invite:
                it works once, to create one account.
            </MudText>
            <MudTextField @bind-Value="_note" Label="Who is it for? (optional)" Variant="Variant.Outlined"
                          MaxLength="200" Immediate="true" Class="mb-3" />
            <MudSelect T="int" @bind-Value="_validDays" Label="Valid for" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="1">1 day</MudSelectItem>
                <MudSelectItem Value="7">7 days</MudSelectItem>
                <MudSelectItem Value="30">30 days</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link"
                       OnClick="CreateInviteAsync" Disabled="_busy">
                Create invite link
            </MudButton>

            @if (_createdLink is not null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4" ContentClass="flex-grow-1">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Copy this link now: it is shown only once.
                    </MudText>
                    <div class="invite-link mb-2">@_createdLink</div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyLinkAsync">
                        Copy link
                    </MudButton>
                </MudAlert>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Elevation="1" Class="pa-4" Style="height: 100%">
            <MudText Typo="Typo.h6" GutterBottom="true">Users</MudText>
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead>
                    <tr>
                        <th>User name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Member since</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@(user.IsAdmin ? "Administrator" : "User")</td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("d")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Invites</MudText>
            @if (_invites.Count == 0)
            {
                <MudText Typo="Typo.body2">No invites yet.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>For</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in _invites)
                        {
                            var status = invite.GetStatus(DateTime.UtcNow);
                            <tr>
                                <td>@(invite.Note ?? "—")</td>
                                <td>@invite.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>@invite.ExpiresAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="StatusColor(status)">
                                        @(status == InviteStatus.Used ? $"Used by {invite.RedeemedBy}" : status.ToString())
                                    </MudChip>
                                </td>
                                <td style="text-align: right">
                                    @if (status == InviteStatus.Open)
                                    {
                                        <MudTooltip Text="Revoke">
                                            <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                                           OnClick="() => RevokeAsync(invite)" aria-label="Revoke invite" />
                                        </MudTooltip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private List<Invite> _invites = [];
    private List<UserRow> _users = [];
    private string? _note;
    private int _validDays = 7;
    private string? _createdLink;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Each action gets its own DI scope: the circuit lives long, a DbContext should not.
    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        _invites = await scope.ServiceProvider.GetRequiredService<InviteService>().GetAllAsync();

        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var admins = (await userManager.GetUsersInRoleAsync(InviteService.AdminRole)).Select(u => u.Id).ToHashSet();
        _users = (await userManager.Users.AsNoTracking().OrderBy(u => u.UserName).ToListAsync())
            .Select(u => new UserRow(u.UserName!, u.Email, u.CreatedAt, admins.Contains(u.Id)))
            .ToList();
    }

    private async Task CreateInviteAsync()
    {
        _busy = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var (_, token) = await scope.ServiceProvider.GetRequiredService<InviteService>()
                .CreateAsync(CurrentUser.UserName!, _note, TimeSpan.FromDays(_validDays));

            _createdLink = Navigation.ToAbsoluteUri($"account/register/{token}").ToString();
            _note = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create the invite: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _createdLink);
            Snackbar.Add("Invite link copied.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Could not copy automatically; select the link and copy it.", Severity.Warning);
        }
    }

    private async Task RevokeAsync(Invite invite)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Revoke invite",
            $"Revoke the invite{(invite.Note is null ? "" : $" for '{invite.Note}'")}? Its link will stop working.",
            yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        if (await scope.ServiceProvider.GetRequiredService<InviteService>().RevokeAsync(invite.Id))
            Snackbar.Add("Invite revoked.", Severity.Success);
        else
            Snackbar.Add("That invite can no longer be revoked.", Severity.Warning);

        await LoadAsync();
    }

    private static Color StatusColor(InviteStatus status) => status switch
    {
        InviteStatus.Open => Color.Info,
        InviteStatus.Used => Color.Success,
        InviteStatus.Revoked => Color.Error,
        _ => Color.Default
    };

    private sealed record UserRow(string UserName, string? Email, DateTime CreatedAt, bool IsAdmin);
}
