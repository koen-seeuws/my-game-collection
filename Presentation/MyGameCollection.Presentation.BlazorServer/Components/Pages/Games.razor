@page "/games"

<PageTitle>Games · My Game Collection</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Games</MudText>

@if (!CurrentUser.IsSignedIn)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="1" Class="pa-3 mb-4 item-toolbar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
            <MudTextField @bind-Value="_search" Placeholder="Search title, platform or notes" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                          Style="min-width: 240px; max-width: 360px" />
            <MudToggleGroup T="CollectionStatus?" @bind-Value="_statusFilter" Size="Size.Small" Color="Color.Primary"
                            CheckMark="true">
                <MudToggleItem T="CollectionStatus?" Value="null" Text="All" />
                <MudToggleItem T="CollectionStatus?" Value="CollectionStatus.Owned" Text="Owned" />
                <MudToggleItem T="CollectionStatus?" Value="CollectionStatus.Wishlist" Text="Wishlist" />
            </MudToggleGroup>
            <MudSelect T="GameSort" @bind-Value="_sort" Label="Sort by" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Style="max-width: 200px">
                <MudSelectItem Value="GameSort.Title">Title</MudSelectItem>
                <MudSelectItem Value="GameSort.ReleaseYear">Release year</MudSelectItem>
                <MudSelectItem Value="GameSort.RecentlyPurchased">Recently purchased</MudSelectItem>
                <MudSelectItem Value="GameSort.Price">Price paid</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_groupByPlatform" Color="Color.Primary" Label="Group by platform" />
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="() => AddGameAsync()">
                Add game
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    var games = VisibleGames.ToList();

    @if (games.Count == 0 && !_loading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Outlined.VideogameAsset" Size="Size.Large" Color="Color.Secondary" />
            <MudText Class="mt-2">
                @(_games.Count == 0 ? "No games here yet. Blow on that cartridge and add your first one!" : "No games match your filters.")
            </MudText>
        </MudPaper>
    }
    else if (_groupByPlatform)
    {
        @foreach (var group in games.GroupBy(g => g.Platform, StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
        {
            <MudText Typo="Typo.h6" Class="item-group-title">@group.Key <span class="item-group-count">@group.Count()</span></MudText>
            <GameCardGrid Games="group" OnEdit="EditGameAsync" OnDelete="DeleteGameAsync" OnAcquire="AcquireGameAsync" />
        }
    }
    else
    {
        <GameCardGrid Games="games" OnEdit="EditGameAsync" OnDelete="DeleteGameAsync" OnAcquire="AcquireGameAsync" />
    }
}
