@page "/wishlist"

<PageTitle>Wishlist · My Game Collection</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Wishlist</MudText>

@if (!CurrentUser.IsSignedIn)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4">
        Everything you are still hunting for. Found one? Hit <MudIcon Icon="@Icons.Material.Filled.AddTask" Size="Size.Small" Color="Color.Success" Style="vertical-align: middle" />
        to move it into your collection.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    var games = WishedGames.ToList();
    var consoles = WishedConsoles.ToList();

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="item-group-title">
        <MudText Typo="Typo.h6">Games <span class="item-group-count">@games.Count</span></MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => WishForGameAsync()">
            Wish for a game
        </MudButton>
    </MudStack>
    @if (games.Count == 0)
    {
        <MudText Class="mud-text-secondary mb-6">No games on your wishlist.</MudText>
    }
    else
    {
        <div class="item-grid mb-6">
            @foreach (var game in games)
            {
                <ItemCard @key="game.Key" Title="@game.Title" Subtitle="@GameCardGrid.Subtitle(game)"
                          ThumbnailUrl="@game.ThumbnailUrl" Icon="@Icons.Material.Outlined.VideogameAsset" Status="game.Status"
                          ShowStatus="false" Notes="@game.Notes"
                          OnOpen="() => OpenGameAsync(game)" OnDelete="() => DeleteGameAsync(game)"
                          OnAcquire="() => AcquireGameAsync(game)">
                    <ItemTags Format="game.Format" Region="game.Region"
                              Completeness="@(game.Format == GameFormat.Physical ? game.Completeness : null)" />
                    <PlayerTags Players="game.Players" />
                </ItemCard>
            }
        </div>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="item-group-title">
        <MudText Typo="Typo.h6">Consoles <span class="item-group-count">@consoles.Count</span></MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => WishForConsoleAsync()">
            Wish for a console
        </MudButton>
    </MudStack>
    @if (consoles.Count == 0)
    {
        <MudText Class="mud-text-secondary">No consoles on your wishlist.</MudText>
    }
    else
    {
        <div class="item-grid wide">
            @foreach (var console in consoles)
            {
                <ItemCard @key="console.Key" Title="@console.Name" Subtitle="@console.Manufacturer"
                          ThumbnailUrl="@console.ThumbnailUrl" Icon="@Icons.Material.Outlined.SportsEsports" Logo="true"
                          Status="console.Status" ShowStatus="false" Notes="@console.Notes"
                          OnOpen="() => OpenConsoleAsync(console)" OnDelete="() => DeleteConsoleAsync(console)"
                          OnAcquire="() => AcquireConsoleAsync(console)">
                    <ItemTags Region="console.Region" Completeness="console.Completeness" />
                </ItemCard>
            }
        </div>
    }
}
