# Copy to .env and adjust.
POSTGRES_USER=gamevault
POSTGRES_PASSWORD=change-me-to-something-long

# Where photos and keys are stored on the host.
DATA_PATH=./data
WEB_PORT=8080
TZ=Europe/Brussels

# Optional: free key from https://rawg.io/apidocs - adds developer, genre, year and artwork to lookups.
RAWG_API_KEY=

# Optional: MediatR (v13+) license key from https://luckypennysoftware.com - the Community license is free
# for individuals / small companies. Without it MediatR works but logs a license warning at startup.
MEDIATR_LICENSE_KEY=

# Optional HTTPS proxy (docker compose --profile https up -d)
SITE_ADDRESS=gamevault.home.arpa
TLS_MODE=internal
